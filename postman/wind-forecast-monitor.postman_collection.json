              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Same delivery day, earlier decision: the latest run is now 07:30, the next is 09:30.",
            "url": {
              "raw": "{{baseUrl}}/api/decision?decision_time=2026-01-15T08:00:00Z",
