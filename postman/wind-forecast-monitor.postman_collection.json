        },
        {
          "name": "Backtest - 90%",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches the January data\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.hours).to.eql(744);",
                  "  pm.expect(b.days.length).to.eql(31);",
                  "  pm.expect(b.hit_rate_pct).to.be.within(85, 95);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Replays all 31 January decisions. Hit rate should be ~89.4%.",
            "url": {
              "raw": "{{baseUrl}}/api/decision/backtest?confidence=0.9&lookback_days=30&decision_hour=11",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decision",
                "backtest"
