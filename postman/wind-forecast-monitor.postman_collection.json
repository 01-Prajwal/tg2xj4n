              "query": [
                {
                  "key": "confidence",
                  "value": "0.9"
                },
                {
                  "key": "lookback_days",
                  "value": "30"
                },
                {
                  "key": "decision_hour",
                  "value": "11"
                }
              ]
            }
          }
        },
        {
          "name": "Backtest - 80%",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
