{
  "info": {
    "name": "Wind Forecast Monitor API",
    "description": "Endpoints of the UK wind forecast monitor. Set baseUrl to http://127.0.0.1:8000 (local) or https://tg2xj4n.vercel.app (live).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "liveUrl",
      "value": "https://tg2xj4n.vercel.app"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches the January data\", () => {",
                  "  pm.expect(pm.response.json().snapshot.forecast_runs).to.eql(536);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Snapshot info, default window, max lead time and the 11:00 cutoff. The frontend calls this first.",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "2. Plan tomorrow (decision support)",
      "item": [
        {
          "name": "Decision - default (31 Jan 11:00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches the January data\", () => {",
                  "  pm.expect(pm.response.json().delivery_day).to.eql(\"2026-02-01\");",
                  "  pm.expect(pm.response.json().run_publish_time).to.eql(\"2026-01-31T09:30:00Z\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Point 1 + 2 for the last January decision: latest run (09:30), next run, tomorrow's 24 hours with the count-on line, error model and GWh totals.",
            "url": {
              "raw": "{{baseUrl}}/api/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decision"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Decision - 15 Jan 11:00, 90%, 30 days",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches the January data\", () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.run_publish_time).to.eql(\"2026-01-15T09:30:00Z\");",
                  "  pm.expect(d.next_run_publish_time).to.eql(\"2026-01-15T12:25:00Z\");",
                  "  pm.expect(d.error_model.n).to.eql(720);",
                  "  pm.expect(d.hours.length).to.eql(24);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Worked example: 09:30 run, 191 GWh forecast, 92 GWh count on, ~100 GWh extra cover.",
            "url": {
              "raw": "{{baseUrl}}/api/decision?decision_time=2026-01-15T11:00:00Z&confidence=0.9&lookback_days=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "decision"
              ],
              "query": [
                {
                  "key": "decision_time",
                  "value": "2026-01-15T11:00:00Z"
                },
                {
                  "key": "confidence",
                  "value": "0.9"
                },
                {
                  "key": "lookback_days",
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "name": "Decision - 15 Jan 08:00 (earlier run)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches the January data\", () => {",
                  "  pm.expect(pm.response.json().run_publish_time).to.eql(\"2026-01-15T07:30:00Z\");",
